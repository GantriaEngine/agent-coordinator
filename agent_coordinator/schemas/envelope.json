  "$defs": {
    "Assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "RunId",
        "Token",
        "Role",
        "SchemaId",
        "SchemaVersion",
        "SchemaHash",
        "Parameters",
        "ExpiresUnixMs"
      ],
      "properties": {
        "RunId": {
          "type": "string",
          "format": "uuid"
        },
        "Token": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "Role": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9.-]{0,95}$"
        },
        "SchemaId": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9.-]{0,95}$"
        },
        "SchemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "SchemaHash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "Parameters": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        },
        "ExpiresUnixMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Evidence": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "Path",
          "SHA256",
          "Bytes"
        ],
        "properties": {
          "Path": {
            "type": "string",
            "maxLength": 512
          },
          "SHA256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "Bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "Parameters": {
      "type": "object",
      "maxProperties": 16,
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000000
      }
    }
  }
